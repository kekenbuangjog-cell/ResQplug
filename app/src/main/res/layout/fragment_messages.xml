<?xml version="1.0" encoding="utf-8"?>
<!-- Fragment Messages: Ad-hoc Mesh Chat with Priority Selection -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Messages Recycler View -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:scrollbars="vertical"
        tools:listitem="@layout/item_message_received" />

    <!-- Priority Selector Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_navy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="PRIORITY: "
            android:textColor="@color/text_gray"
            android:textSize="9sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPrioritySos"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/pixel_button_sos"
            android:fontFamily="monospace"
            android:text="@string/dash_btn_sos"
            android:textColor="@color/alert_red"
            android:textSize="8sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPriorityEvac"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/pixel_button_evac"
            android:fontFamily="monospace"
            android:text="@string/dash_btn_evac"
            android:textColor="@color/alert_amber"
            android:textSize="8sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPriorityStatus"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/pixel_button_status"
            android:fontFamily="monospace"
            android:text="@string/dash_btn_status"
            android:textColor="@color/accent_green"
            android:textSize="8sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Message Compose Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_black"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/etMessageInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/compose_input_bg"
            android:fontFamily="monospace"
            android:hint="@string/dash_compose_hint"
            android:imeOptions="actionSend"
            android:inputType="textShortMessage"
            android:maxLines="3"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnSendMessage"
            android:layout_width="72dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_send"
            android:fontFamily="monospace"
            android:text="@string/dash_send"
            android:textColor="@color/bg_navy"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
