<?xml version="1.0" encoding="utf-8"?>
<!-- Fragment SOS Hub: Live Emergency Distress Triage & Dispatch Center -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="🚨 SOS DISTRESS TRIAGE HUB"
            android:textColor="@color/alert_red"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSosActiveCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/alert_amber"
            android:textSize="9sp"
            android:textStyle="bold"
            tools:text="[ 2 OPEN ]" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:text="Direct responder triage &amp; emergency dispatch queue"
        android:textColor="@color/text_gray"
        android:textSize="8sp" />

    <!-- Divider Bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/border_dark" />

    <!-- Empty State View (Shown when 0 open SOS calls) -->
    <LinearLayout
        android:id="@+id/layoutSosEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="(^_^)"
            android:textColor="@color/accent_green"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:text="[ ALL CLEAR : NO OPEN SOS CALLS ]"
            android:textColor="@color/accent_green"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="All sectors reporting normal status. Listening on 915MHz..."
            android:textColor="@color/text_gray"
            android:textSize="8sp" />

    </LinearLayout>

    <!-- SOS Incidents Recycler View -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSosIncidents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        tools:itemCount="3"
        tools:listitem="@layout/item_sos_incident" />

</LinearLayout>
