<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Pixel Art Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <Button
                android:id="@+id/btnLoginBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/pixel_card"
                android:fontFamily="monospace"
                android:padding="0dp"
                android:text="←"
                android:textColor="@color/accent_green"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="ELDROID ACTIVITY 7.0"
                    android:textColor="@color/accent_green"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="[ AUTHENTICATION GATE // SCREEN 1 ]"
                    android:textColor="@color/text_gray"
                    android:textSize="10sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/loginProgressBar"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:visibility="gone"
                android:indeterminateTint="@color/accent_green" />
        </LinearLayout>

        <!-- Main Pixel Art Authentication Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/pixel_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="┌─[ STUDENT CREDENTIALS ]"
                android:textColor="@color/signal_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="14dp"
                android:fontFamily="monospace"
                android:text="│ Sign in to unlock ESP32 LED and LoRa controls."
                android:textColor="@color/text_gray"
                android:textSize="9sp" />

            <!-- Email Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="EMAIL"
                android:textColor="@color/text_white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etLoginEmail"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/compose_input_bg"
                android:fontFamily="monospace"
                android:hint="Email"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="10dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_gray"
                android:textSize="11sp" />

            <!-- Password Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:text="PASSWORD"
                android:textColor="@color/text_white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etLoginPassword"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/compose_input_bg"
                android:fontFamily="monospace"
                android:hint="Password"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:paddingHorizontal="10dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_gray"
                android:textSize="11sp" />

            <!-- Sign In Pixel Button -->
            <Button
                android:id="@+id/btnActionSignIn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/accent_green"
                android:fontFamily="monospace"
                android:text="[ 🔑 SIGN IN ]"
                android:textColor="@color/bg_black"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Register Pixel Button -->
            <Button
                android:id="@+id/btnActionRegister"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/border_dark"
                android:fontFamily="monospace"
                android:text="[ 📝 REGISTER ]"
                android:textColor="@color/signal_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 8 FPS Animated Terminal Status Box -->
        <TextView
            android:id="@+id/tvLoginStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/compose_input_bg"
            android:fontFamily="monospace"
            android:gravity="center"
            android:padding="10dp"
            android:text="[ READY // AWAITING COMMAND >_ ]"
            android:textColor="@color/accent_green"
            android:textSize="10sp" />

    </LinearLayout>
</ScrollView>
