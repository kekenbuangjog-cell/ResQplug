<?xml version="1.0" encoding="utf-8"?>
<!-- Retro 8-Bit Clearance Confirmation Modal -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/pixel_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvClearanceHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="[ CLEARANCE GRANTED ]"
        android:textColor="@color/accent_green"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Divider Bar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/signal_cyan" />

    <!-- Role Badge Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvClearanceBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_role_responder"
            android:fontFamily="monospace"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="[ RESPONDER ]"
            tools:textColor="@color/alert_amber" />

    </LinearLayout>

    <!-- Description / Unlocked Powers -->
    <TextView
        android:id="@+id/tvClearanceDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/text_white"
        android:textSize="10sp"
        tools:text="Field triage and dispatch capabilities are now active on your device." />

    <!-- Acknowledge Button -->
    <Button
        android:id="@+id/btnClearanceOk"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/btn_send"
        android:fontFamily="monospace"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="[ CONTINUE ]"
        android:textColor="@color/bg_navy"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
