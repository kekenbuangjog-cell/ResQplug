<?xml version="1.0" encoding="utf-8"?>
<!-- Retro Messenger: Active contact circle item with iconic online dot -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="68dp"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <!-- Avatar Frame with Online Dot -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <!-- Pixel Avatar Box -->
        <TextView
            android:id="@+id/tvContactAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/pixel_avatar_box"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="@color/accent_green"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="M" />

        <!-- Iconic Green Online Dot -->
        <View
            android:id="@+id/vOnlineStatusDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/dot_online_green" />

    </FrameLayout>

    <!-- Person Name -->
    <TextView
        android:id="@+id/tvContactName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:textColor="@color/text_white"
        android:textSize="9sp"
        android:textStyle="bold"
        tools:text="Maria" />

    <!-- Hop / Link Tag -->
    <TextView
        android:id="@+id/tvContactHop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="@color/signal_cyan"
        android:textSize="7sp"
        tools:text="1 HOP" />

    <!-- Role Tag -->
    <TextView
        android:id="@+id/tvContactRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:textSize="6sp"
        android:textStyle="bold"
        tools:text="[ CITIZEN ]"
        tools:textColor="@color/accent_green" />

</LinearLayout>