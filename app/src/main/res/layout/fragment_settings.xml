<?xml version="1.0" encoding="utf-8"?>
<!-- Fragment Settings: Node Identity, LoRa RF Parameters, and Hardware Diagnostics -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <!-- ========== SECTION 1: NODE IDENTITY ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/settings_node_info"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/pixel_card"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSettingsNodeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Callsign / Name: Juan" />

            <TextView
                android:id="@+id/tvSettingsDeviceId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/signal_cyan"
                android:textSize="11sp"
                tools:text="Dongle UID: RQP-SIM-5421" />

        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- ========== SECTION 2: LORA RF PARAMETERS ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/settings_rf_config"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/pixel_card"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSettingsFrequency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/settings_frequency"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSettingsTxPower"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text="@string/settings_tx_power"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSettingsBandwidth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text="@string/settings_bandwidth"
                android:textColor="@color/text_gray"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- ========== SECTION 3: HARDWARE DIAGNOSTICS ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/settings_usb_diag"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/pixel_card"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSettingsUsbStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/settings_usb_status"
                android:textColor="@color/accent_green"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSettingsMeshStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text="@string/settings_mesh_status"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Bottom spacer for scroll padding -->
        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

    </LinearLayout>

</ScrollView>
