<?xml version="1.0" encoding="utf-8"?>
<!-- 8-Bit Dashboard: Mesh Network + Priority Queue + Actions -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    tools:context=".DashboardActivity">

    <!-- Starfield Background -->
    <com.example.resqplug.ui.StarfieldView
        android:id="@+id/dashStarfield"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Dashboard Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_navy"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="◈━━━◈  RESQPLUG"
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDashDeviceId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/signal_cyan"
                android:textSize="7sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <!-- Mesh Network Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/pixel_status_box"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/dash_mesh_network"
                android:textColor="@color/accent_green"
                android:textSize="8sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"
                android:background="@color/border_dark" />

            <!-- Node Count + Signal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNodeCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_white"
                    android:textSize="8sp"
                    tools:text="1 NODES ACTIVE" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/dash_signal"
                    android:textColor="@color/text_gray"
                    android:textSize="7sp" />

                <ProgressBar
                    android:id="@+id/signalBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="80dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="6dp"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_bar_retro"
                    tools:progress="75" />
            </LinearLayout>

            <!-- Node Diagram -->
            <TextView
                android:id="@+id/tvNodeDiagram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/accent_green"
                android:textSize="7sp"
                tools:text="● You  ──  ● Node-A" />
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <!-- Message Queue Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/pixel_status_box"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/dash_message_queue"
                android:textColor="@color/accent_green"
                android:textSize="8sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"
                android:background="@color/border_dark" />

            <!-- SOS Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="SOS"
                    android:textColor="@color/alert_red"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSosCount"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_white"
                    android:textSize="8sp"
                    tools:text="[ 0 ]" />

                <ProgressBar
                    android:id="@+id/sosBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_weight="1"
                    android:max="20"
                    android:progressDrawable="@drawable/progress_bar_sos" />
            </LinearLayout>

            <!-- EVAC Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="EVAC"
                    android:textColor="@color/alert_amber"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEvacCount"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_white"
                    android:textSize="8sp"
                    tools:text="[ 0 ]" />

                <ProgressBar
                    android:id="@+id/evacBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_weight="1"
                    android:max="20"
                    android:progressDrawable="@drawable/progress_bar_evac" />
            </LinearLayout>

            <!-- STATUS Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="STATUS"
                    android:textColor="@color/status_ok"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusCount"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_white"
                    android:textSize="8sp"
                    tools:text="[ 0 ]" />

                <ProgressBar
                    android:id="@+id/statusBar"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_weight="1"
                    android:max="20"
                    android:progressDrawable="@drawable/progress_bar_retro" />
            </LinearLayout>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pixel_button_sos"
                android:fontFamily="monospace"
                android:paddingStart="24dp"
                android:paddingTop="10dp"
                android:paddingEnd="24dp"
                android:paddingBottom="10dp"
                android:text="@string/dash_btn_sos"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="9sp"
                android:textStyle="bold" />

            <View
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnEvac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pixel_button_evac"
                android:fontFamily="monospace"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="18dp"
                android:paddingBottom="10dp"
                android:text="@string/dash_btn_evac"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="9sp"
                android:textStyle="bold" />

            <View
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pixel_button_status"
                android:fontFamily="monospace"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="18dp"
                android:paddingBottom="10dp"
                android:text="@string/dash_btn_status"
                android:textAllCaps="false"
                android:textColor="@color/text_white"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom Bar: Scene Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSceneProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="@string/dash_scene_progress"
                android:textColor="@color/accent_green"
                android:textSize="7sp" />

            <ProgressBar
                android:id="@+id/sceneProgressBar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="120dp"
                android:layout_height="6dp"
                android:max="11"
                android:progress="1"
                android:progressDrawable="@drawable/progress_bar_retro" />
        </LinearLayout>

    </LinearLayout>

    <!-- Fade Overlay (for transition) -->
    <View
        android:id="@+id/fadeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_black"
        android:alpha="1.0" />

</FrameLayout>
