<?xml version="1.0" encoding="utf-8"?>
<!-- 8-Bit Name Input Dialog -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_black"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="@string/dialog_connected_title"
        android:textColor="@color/accent_green"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="@string/dialog_connected_msg"
        android:textColor="@color/text_white"
        android:textSize="10sp" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/signal_cyan" />

    <!-- Name Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/dialog_name_label"
        android:textColor="@color/text_gray"
        android:textSize="10sp" />

    <!-- Name Input -->
    <EditText
        android:id="@+id/etUserName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/compose_input_bg"
        android:fontFamily="monospace"
        android:hint="@string/dialog_name_hint"
        android:imeOptions="actionDone"
        android:inputType="textPersonName"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/text_white"
        android:textColorHint="@color/text_gray"
        android:textSize="11sp"
        tools:text="Juan" />

    <!-- OK Button -->
    <Button
        android:id="@+id/btnDialogOk"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/pixel_button_status"
        android:fontFamily="monospace"
        android:text="@string/dialog_ok"
        android:textAllCaps="false"
        android:textColor="@color/text_white"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
