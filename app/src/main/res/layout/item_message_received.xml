<?xml version="1.0" encoding="utf-8"?>
<!-- Received message bubble — left aligned, gray border -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="48dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_received"
        android:orientation="vertical"
        android:maxWidth="280dp">

        <!-- Header: node dot + name -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="●"
                android:textSize="8sp"
                tools:textColor="#3498DB" />

            <TextView
                android:id="@+id/tvSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="monospace"
                android:textSize="8sp"
                android:textStyle="bold"
                tools:text="Node-A"
                tools:textColor="#3498DB" />
        </LinearLayout>

        <!-- Message text -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_white"
            android:textSize="8sp"
            tools:text="&quot;All clear here&quot;" />

        <!-- Footer: time + priority -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_gray"
                android:textSize="6sp"
                tools:text="12:34" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="monospace"
                android:textSize="6sp"
                android:textStyle="bold"
                tools:text="STATUS"
                tools:textColor="@color/status_ok" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
