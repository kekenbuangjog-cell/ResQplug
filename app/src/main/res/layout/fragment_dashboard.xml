<?xml version="1.0" encoding="utf-8"?>
<!-- Fragment Dashboard: SOS trigger, Official Disaster Bulletin, and Mesh Health Summary -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboardScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <!-- ========== SOS BUTTON ========== -->
        <Button
            android:id="@+id/btnSos"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/pixel_button_sos_large"
            android:fontFamily="monospace"
            android:text="@string/dash_sos_button"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- ========== BULLETIN SECTION LABEL ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/dash_section_bulletin"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />

        <!-- ========== BULLETIN CARD ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/pixel_card"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBulletinSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/dash_bulletin_source"
                android:textColor="@color/signal_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBulletinText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:text="@string/dash_bulletin_text"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvBulletinUpdated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="@string/dash_bulletin_updated"
                android:textColor="@color/text_gray"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- ========== MESH HEALTH SECTION LABEL ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/dash_section_mesh"
            android:textColor="@color/text_gray"
            android:textSize="11sp" />

        <!-- ========== MESH HEALTH CARD ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/pixel_card"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMeshActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                tools:text="📡 Active Nodes in Range: 5 reachable" />

            <TextView
                android:id="@+id/tvMeshNearest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                tools:text="🟢 Nearest Link: -68 dBm (Direct / 1 Hop)" />

            <TextView
                android:id="@+id/tvMeshFarthest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                tools:text="🔁 Furthest Reach: 3 Hops away (~4.2 km)" />

        </LinearLayout>

        <!-- Bottom spacer for scroll padding -->
        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

    </LinearLayout>

</ScrollView>
