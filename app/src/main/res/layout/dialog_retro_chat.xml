<?xml version="1.0" encoding="utf-8"?>
<!-- Retro Disaster Chat Room Modal / Screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:orientation="vertical">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_navy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/btnChatBack"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:background="@drawable/pixel_status_box"
            android:fontFamily="monospace"
            android:text="&lt;"
            android:textColor="@color/accent_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/accent_green"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="MARIA SANTOS" />

            <TextView
                android:id="@+id/tvChatSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_gray"
                android:textSize="8sp"
                tools:text="ONLINE - 1 HOP - LORA 915MHz" />

        </LinearLayout>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_dark" />

    <!-- Chat Messages Recycler View -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDialogMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:scrollbars="vertical" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_dark" />

    <!-- Message Compose Row with Integrated Single Priority Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_black"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <!-- Clickable Priority Badge (Cycles: STATUS -> EVAC -> SOS) -->
        <Button
            android:id="@+id/btnPriorityCycle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/badge_priority_cycle_status"
            android:fontFamily="monospace"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="[ STATUS ]"
            android:textColor="@color/accent_green"
            android:textSize="9sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDialogMessageInput"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/compose_input_bg"
            android:fontFamily="monospace"
            android:hint="@string/dash_compose_hint"
            android:imeOptions="actionSend"
            android:inputType="textShortMessage"
            android:maxLines="3"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray"
            android:textSize="10sp" />

        <ImageButton
            android:id="@+id/btnDialogSendMessage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_send"
            android:contentDescription="@string/dash_send"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_send_retro" />

    </LinearLayout>

</LinearLayout>