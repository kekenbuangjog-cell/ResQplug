<?xml version="1.0" encoding="utf-8"?>
<!-- Retro Messenger: Conversation row with avatar, iconic online dot, name, and last message preview -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/pixel_conversation_item_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <!-- Avatar + Online Indicator -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <TextView
            android:id="@+id/tvConvAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/pixel_avatar_box"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="@color/accent_green"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="M" />

        <View
            android:id="@+id/vConvOnlineDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/dot_online_green" />

    </FrameLayout>

    <!-- Content: Name, Message Preview, Time, Priority -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Top row: Name & Timestamp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvConvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Maria Santos" />

            <TextView
                android:id="@+id/tvConvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/text_gray"
                android:textSize="9sp"
                tools:text="12:34" />

        </LinearLayout>

        <!-- Bottom row: Priority Tag & Message Snippet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Priority Chip -->
            <TextView
                android:id="@+id/tvConvPriorityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_priority_status"
                android:fontFamily="monospace"
                android:paddingStart="4dp"
                android:paddingTop="1dp"
                android:paddingEnd="4dp"
                android:paddingBottom="1dp"
                android:textColor="@color/accent_green"
                android:textSize="7sp"
                android:textStyle="bold"
                tools:text="STATUS" />

            <TextView
                android:id="@+id/tvConvLastMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/text_gray"
                android:textSize="10sp"
                tools:text="All clear here at Banilad Gym" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>