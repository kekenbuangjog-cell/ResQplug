<?xml version="1.0" encoding="utf-8"?>
<!-- Retro SOS Distress Incident Card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/pixel_card_sos_alert"
    android:orientation="vertical">

    <!-- Header: Citizen Name + Hops + Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvIncidentCitizen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textColor="@color/alert_red"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="🚨 MARIA SANTOS" />

        <TextView
            android:id="@+id/tvIncidentHop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/signal_cyan"
            android:textSize="8sp"
            tools:text="1 HOP" />

        <TextView
            android:id="@+id/tvIncidentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_gray"
            android:textSize="8sp"
            tools:text="12:35" />

    </LinearLayout>

    <!-- Distress Message Text -->
    <TextView
        android:id="@+id/tvIncidentMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:textColor="@color/text_white"
        android:textSize="10sp"
        android:textStyle="bold"
        tools:text="&quot;Need emergency medical aid at Block 3. Flood water rising fast!&quot;" />

    <!-- Triage Status Badge Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvIncidentStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_triage_open"
            android:fontFamily="monospace"
            android:textSize="8sp"
            android:textStyle="bold"
            tools:text="[ 🚨 OPEN - AWAITING AID ]"
            tools:textColor="@color/alert_red" />

        <TextView
            android:id="@+id/tvIncidentResponderTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/text_gray"
            android:textSize="8sp"
            android:visibility="gone"
            tools:text="Resp: Capt. Reyes" />

    </LinearLayout>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnIncidentTriage"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/btn_send_evac"
            android:fontFamily="monospace"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="[ 🚑 DISPATCH AID ]"
            android:textColor="@color/bg_navy"
            android:textSize="9sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnIncidentChat"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/pixel_status_box"
            android:fontFamily="monospace"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="[ 💬 CHAT CITIZEN ]"
            android:textColor="@color/accent_green"
            android:textSize="9sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
